---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const guides = (await getCollection('tuideDocs')).sort((a, b) => a.data.order - b.data.order);
	return guides.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, guides, prev: guides[i - 1], next: guides[i + 1] } }));
}

const { entry, guides, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const REPO = 'https://github.com/LorenzoAdr/TIDE';
const nav = [
	{ href: '/tuide/', label: 'tuide' },
	{ href: '/tuide/docs/', label: 'Docs' },
	{ href: REPO, label: 'GitHub' },
];
---
<BaseLayout title={`${entry.data.title} | tuide docs`} description={entry.data.summary} crumb="TUIDE / DOCS" nav={nav}>
	<div class="wrap doc-page">
		<aside class="doc-side" aria-label="Documentation">
			<p class="label">Guides</p>
			<ol class="doc-nav">
				{guides.map((g) => (
					<li><a href={`/tuide/docs/${g.id}/`} aria-current={g.id === entry.id ? 'page' : undefined}>{g.data.title}</a></li>
				))}
			</ol>
			{toc.length > 1 && (
				<>
					<p class="label">On this page</p>
					<ol class="doc-toc">
						{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
					</ol>
				</>
			)}
		</aside>
		<article class="doc">
			<header class="doc-head">
				<p class="label">tuide · guide {String(entry.data.order).padStart(2, '0')}</p>
				<h1>{entry.data.title}</h1>
				<p class="mono dim">{entry.data.summary}</p>
			</header>
			<div class="doc-body">
				<Content />
			</div>
			<footer class="doc-foot">
				<nav class="doc-pager" aria-label="Previous and next guide">
					{prev ? <a href={`/tuide/docs/${prev.id}/`}><span class="label">Previous</span>{prev.data.title}</a> : <span />}
					{next && <a class="next" href={`/tuide/docs/${next.id}/`}><span class="label">Next</span>{next.data.title}</a>}
				</nav>
				<p class="mono dim">Source: <a href={entry.data.source}>docs/{entry.id}.md</a>{entry.data.commit && <> at {entry.data.commit}</>}{entry.data.updated && <>, {entry.data.updated}</>}</p>
			</footer>
		</article>
	</div>
</BaseLayout>
