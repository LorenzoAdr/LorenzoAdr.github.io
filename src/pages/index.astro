---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrimFigure from '../components/TrimFigure.astro';

const LINKEDIN_URL = 'https://es.linkedin.com/in/lorenzo-arias-del-real';
const GITHUB_URL = 'https://github.com/LorenzoAdr';
const CONTACT_EMAIL = 'lorenzo.adr@proton.me';

const experience = [
	{
		period: '2025 – Present',
		role: 'Senior Flight Simulation Engineer',
		platform: 'EC135 full flight simulator',
		text: 'Responsible for the AFCS, developed together with the team, and for the architecture of the simulator qualification (QTG) environment: modular, platform-agnostic and built for efficient execution. Designed the flight test campaign for simulator data gathering.',
	},
	{
		period: '2024 – 2025',
		role: 'Flight Dynamics Engineer',
		platform: 'H225M',
		text: 'Physical and flight dynamics models, tuned and validated against flight test data, working closely with Airbus Helicopters.',
	},
	{
		period: '2018 – 2024',
		role: 'Flight Simulation Engineer',
		platform: 'Fixed-wing',
		text: 'Tactical Environment of the A400M simulator: control, navigation and flight dynamics algorithms for tactical entities, including air-to-air refuelling. Flight dynamics models for Level D simulators: A330, A330 MRTT, A320, B737, ATR72.',
	},
];

const projects = [
	{
		name: 'tuide',
		kind: 'Terminal IDE',
		stack: 'C++17 · FTXUI',
		state: 'Active',
		on: true,
		text: 'A full IDE in the terminal: multi-language indexing over LSP, debugging over DAP, symbol and core dump forensics, in 20–30 MB of RAM.',
		links: [
			{ href: '/tuide/', label: 'Project page' },
			{ href: 'https://github.com/LorenzoAdr/TIDE', label: 'Repository' },
		],
	},
	{
		name: 'VarMonitor',
		kind: 'Runtime observability',
		stack: 'C++20 · POSIX SHM',
		state: 'Maintained',
		text: 'Real-time variable monitor for C++ applications over shared memory, with a browser front end for plots, alarms and recording.',
		links: [
			{ href: '/varmonitor/', label: 'Project page' },
			{ href: '/VarMonitor/docs/en/', label: 'Docs' },
			{ href: 'https://github.com/LorenzoAdr/RealTimeMonitor', label: 'Repository' },
		],
	},
	{
		name: 'PulseIntegrity',
		kind: 'Link analysis',
		stack: 'MAVLink',
		state: 'Experimental',
		text: 'Real-time integrity and stability analysis of MAVLink networks.',
		links: [{ href: '/pulseintegrity/', label: 'Project page' }],
	},
];

const disciplines = ['Flight dynamics', 'Flight control systems (AFCS)', 'FSTD qualification', 'C++', 'Software architecture', 'Real-time systems'];
---

<BaseLayout>
	<section class="wrap hero">
		<div>
			<h1>Lorenzo Arias del&nbsp;Real</h1>
			<p class="role">Senior Flight Simulation Engineer · Real-time C++</p>
			<p class="about">
				Aeronautical engineer (MSc, UPM) with 8 years in full flight simulator development at Indra, across fixed-wing and rotorcraft
				platforms. My work spans flight dynamics modelling, flight control systems and simulator qualification. Outside work I build
				open-source tools for real-time C++ systems.
			</p>
			<ul class="disc" aria-label="Disciplines">
				{disciplines.map((d) => <li>{d}</li>)}
			</ul>
			<p class="links">
				<a href={GITHUB_URL} rel="me noopener">GitHub</a>
				<a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a>
				<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			</p>
		</div>
		<TrimFigure />
	</section>

	<div class="wrap">
		<section class="block" id="experience">
			<header><p class="label">Indra</p><h2>Experience</h2></header>
			<div class="body">
				<div class="rows">
					{experience.map((e) => (
						<article class="row">
							<p class="mono">{e.period}</p>
							<div><h3>{e.role}</h3><p class="sub">{e.platform}</p></div>
							<p class="desc">{e.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="block" id="projects">
			<header><p class="label">Open source</p><h2>Projects</h2></header>
			<div class="body">
				<p class="prose dim">Personal tools for real-time C++ work, built and maintained in my own time.</p>
				<div class="rows">
					{projects.map((p) => (
						<article class="row">
							<p class="mono">{p.stack}</p>
							<div><h3 class="proj">{p.name}<span class:list={['state', p.on && 'on']}>{p.state}</span></h3><p class="sub">{p.kind}</p></div>
							<div>
								<p class="desc">{p.text}</p>
								<p class="links">{p.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="block" id="contact">
			<header><p class="label">Reach me</p><h2>Contact</h2></header>
			<div class="body">
				<dl class="contact">
					<div><dt>Email</dt><dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd></div>
					<div><dt>LinkedIn</dt><dd><a href={LINKEDIN_URL} rel="me noopener">lorenzo-arias-del-real</a></dd></div>
					<div><dt>GitHub</dt><dd><a href={GITHUB_URL} rel="me noopener">LorenzoAdr</a></dd></div>
				</dl>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 40px; align-items: start; padding-block: 48px 64px; }
	.hero h1 { font-size: clamp(3rem, 7.6vw, 5.6rem); letter-spacing: 0.005em; }
	.role { font: 500 0.95rem var(--font-mono); margin-top: 14px; }
	.about { margin-top: 18px; color: var(--ink-2); max-width: 54ch; }
	.disc { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
	.disc li { font: 400 0.74rem var(--font-mono); border: 1px solid var(--rule); padding: 2px 8px; background: var(--sheet); }
	.hero .links { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 22px; font: 500 0.82rem var(--font-mono); }
	.proj { text-transform: none; }
	.contact { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0 28px; border-top: 1px solid var(--rule); }
	.contact div { padding-block: 12px; border-bottom: 1px solid var(--rule); }
	.contact dt { font: 400 0.72rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
	@media (max-width: 860px) { .hero { grid-template-columns: 1fr; gap: 32px; padding-block: 32px 44px; } }
</style>
